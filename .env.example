# Agent Server Configuration
AGENT_HOST=0.0.0.0
AGENT_PORT=5002
#AGENT_SSL_KEYFILE=/path_to/ssl_key.pem
#AGENT_SSL_CERTFILE=/path_to/ssl_cert.pem

# Python Logging
PYTHON_LOG_LEVEL=INFO

USE_INMEMORY_SAVER=true

# pgvector credentials for agentic memory (used when USE_INMEMORY_SAVER=false)
POSTGRES_USER=pgvector
POSTGRES_PASSWORD=pgvector
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_DB=pgvector

# exception
LANGFUSE_SECRET_KEY=sk-lf-f46b492e-9335-
LANGFUSE_PUBLIC_KEY=pk-lf-dfa0dab0-c486-
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

#Google Vertex AI service creds
GOOGLE_APPLICATION_CREDENTIALS_CONTENT='{
    "type": "service_account",
    "project_id": "data-and-ai-gemini",
    ...
    ...
    ...
    "universe_domain": "googleapis.com"
  }'

# MCP config — Snowflake MCP (primary, uses SSO token from request)
MCP_SERVER_NAME=snowflake
MCP_SERVER_URL=https://your-snowflake-mcp-host/mcp
MCP_TRANSPORT_PROTOCOL=streamable_http
# MCP_API_KEY=  # fallback when SSO token is not available

# Atlan MCP (data catalog — schema metadata, lineage, business context)
ATLAN_MCP_URL=https://redhat.atlan.com/mcp/api-key
ATLAN_MCP_API_KEY=your_atlan_api_key
MCP_API_KEY=your_mcp_api_key

# Snowflake config
SNOWFLAKE_ACCOUNT=your_snowflake_account
SNOWFLAKE_USER_TEST=your_snowflake_service_user
# Backward-compatible alias (optional):
# SNOWFLAKE_USER=your_snowflake_service_user
SNOWFLAKE_ROLE=your_snowflake_role
# Key-pair auth (recommended). PEM private key; use \n for newlines in .env if single line.
SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Only if the key is encrypted:
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_private_key_passphrase
# Password auth (optional fallback; not used if SNOWFLAKE_PRIVATE_KEY is set):
# SNOWFLAKE_PASSWORD=

SNOWFLAKE_WAREHOUSE=your_snowflake_warehouse
SNOWFLAKE_DATABASE=your_snowflake_database
SNOWFLAKE_SCHEMA=your_snowflake_schema
# Multiple databases (comma-separated); pairs with SNOWFLAKE_SCHEMA or schema-only list below:
# SNOWFLAKE_ALLOWED_DATABASES=LEARNINGSOURCES_DB,LEARNINGAGGREGATE_DB
# Schemas: fully qualified DATABASE.SCHEMA and/or SCHEMA names (× each allowed database):
# SNOWFLAKE_ALLOWED_SCHEMAS=LEARNINGSOURCES_DB.INTERNAL_MARTS,INTERNAL_MARTS
SNOWFLAKE_ALLOWED_TABLES=your_snowflake_allowed_tables
SNOWFLAKE_QUERY_TIMEOUT=60
SNOWFLAKE_MAX_ROWS=1000
# Shadowbot sends X-Authorization-Snowflake for per-user OAuth. If that token fails
# (Invalid OAuth access token), use service account from env/secret instead:
SNOWFLAKE_PREFER_ENV_CREDENTIALS=false
# Or keep OAuth first but retry with SNOWFLAKE_PRIVATE_KEY / SNOWFLAKE_PASSWORD when OAuth fails:
SNOWFLAKE_OAUTH_FALLBACK_TO_ENV=true

# Plotting (matplotlib + seaborn — data-viz-plots skill)
PLOT_ENABLED=true
PLOT_MAX_ROWS=5000
# PLOT_ARTIFACT_DIR=/tmp/snowflake-bot-plots
# Public URL prefix so Shadowbot can load chart images (set in preprod/prod):
# AGENT_PUBLIC_BASE_URL=https://snowflake-bot-rhu-platforms--pipeline.apps....openshiftapps.com

# Shadowbot JWT (shadowbot-agent-api-integration skill / EmployeeIDP)
# Team / platform docs often use different names — map them like this:
#
#   Team doc          →  Env var in this agent
#   OAUTH_ISSUER      →  AUTH_ISSUER
#   JWKS_URL          →  AUTH_JWKS_URL
#   AUTH_AUDIENCE     →  AUTH_AUDIENCE  (same name, value: account)
#
# Issuer and JWKS must come from the SAME environment (both prod or both stage).
AUTH_ENABLED=true
AUTH_AUDIENCE=account
AUTH_ALGORITHMS=RS256
AUTH_VERIFY_EXP=true
AUTH_VERIFY_AUD=true

# Preprod / stage (default for local dev against preprod Shadowbot)
AUTH_ISSUER=https://auth.stage.redhat.com/auth/realms/EmployeeIDP
AUTH_JWKS_URL=https://auth.stage.redhat.com/auth/realms/EmployeeIDP/protocol/openid-connect/certs

# Production — uncomment BOTH lines together
# AUTH_ISSUER=https://auth.redhat.com/auth/realms/EmployeeIDP
# AUTH_JWKS_URL=https://auth.redhat.com/auth/realms/EmployeeIDP/protocol/openid-connect/certs